---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBlock from '@/components/CtaBlock.astro';
import { STRATEGIC_INDUSTRIES, OTHER_INDUSTRIES } from '@/data/industries';

const work = await getCollection('work');
// Relevant case study per strategic sector (by id).
const proof: Record<string, string> = {
  mining: 'gregbev-inspection-platform',
  'financial-services': 'ttmk-lending-platform',
  agriculture: 'shearflow',
};
const byId = Object.fromEntries(work.map((w) => [w.id, w]));
---

<BaseLayout
  title="Industries: Mining, Financial Services & Agricultural Technology"
  description="Technology solutions for mining, financial services and agriculture, as well as government, development organisations, education, healthcare and logistics across Southern Africa."
>
  <PageHero
    label="Industries"
    title="Technology for organisations where the work is operational."
    lead="We focus on sectors where technology has to survive real conditions: large sites, field teams, regulated money, public accountability. Three of them are strategic for us. We work well beyond them too."
    seed={9}
  />

  <div class="container container--wide">
    <Breadcrumbs items={[{ label: 'Industries' }]} visible={false} />
  </div>

  {STRATEGIC_INDUSTRIES.map((ind, i) => {
    const cs = byId[proof[ind.id]];
    return (
      <section id={ind.id} class:list={['ind', { 'ind--alt': i % 2 === 1 }]} aria-labelledby={`${ind.id}-h`}>
        <div class="container container--wide ind__grid">
          <div class="ind__head" data-reveal>
            <h2 id={`${ind.id}-h`}>{ind.name}</h2>
          </div>
          <div class="ind__body" data-reveal style="--reveal-i:1">
            <p class="ind__lead">{ind.body}</p>
            {cs && (
              <a href={`/work/${cs.id}`} class="ind__proof">
                <span class="ind__proof-label">Related work</span>
                <span class="ind__proof-title">{cs.data.title}</span>
                <span class="ind__proof-client">{cs.data.client}</span>
                <Icon name="ph:arrow-right-light" aria-hidden="true" />
              </a>
            )}
          </div>
          <div class="ind__needs" data-reveal style="--reveal-i:2">
            <h3>What we help with</h3>
            <ul role="list">{ind.needs.map((n) => <li>{n}</li>)}</ul>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section others" aria-labelledby="others-h">
    <div class="container container--wide">
      <div class="others__head" data-reveal>
        <h2 id="others-h">Any organisation with complex technology needs.</h2>
      </div>
      <dl class="others__list">
        {OTHER_INDUSTRIES.map((o, i) => (
          <div data-reveal style={`--reveal-i:${i}`}>
            <dt>{o.name}</dt>
            <dd>{o.note}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBlock heading="Working in a sector we haven’t listed?" body="The underlying problems tend to be similar: field work, compliance, money, data and people. Tell us about yours." />
</BaseLayout>

<style>
  .ind {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: var(--header-h);
  }
  .ind--alt {
    background: var(--paper);
  }
  .ind__grid {
    display: grid;
    gap: 2rem;
  }
  .ind__head h2 {
    font-size: var(--text-h1);
    letter-spacing: var(--tracking-display);
    max-width: 10ch;
  }
  .ind__lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--ink);
    max-width: 56ch;
  }
  .ind__proof {
    position: relative;
    display: grid;
    gap: 0.15rem;
    margin-top: 2rem;
    padding: 1rem 2.5rem 1rem 1rem;
    border-left: 2px solid var(--signal);
    background: color-mix(in srgb, var(--brand-050) 70%, transparent);
    color: inherit;
    text-decoration: none;
    max-width: 30rem;
  }
  .ind__proof-label {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--label);
  }
  .ind__proof-title {
    font-weight: 600;
    color: var(--ink-strong);
  }
  .ind__proof-client {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .ind__proof :global(svg) {
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    transform: translateY(-50%);
    color: var(--brand-700);
    transition: transform var(--dur) var(--ease-out);
  }
  .ind__proof:hover .ind__proof-title {
    color: var(--brand-700);
  }
  .ind__proof:hover :global(svg) {
    transform: translate(3px, -50%);
  }
  .ind__needs h3 {
    font-family: var(--font-sans);
    font-stretch: normal;
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--label);
    margin-bottom: 0.75rem;
  }
  .ind__needs ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .ind__needs li {
    display: flex;
    align-items: center;
    padding: 0.6rem 0.75rem;
    line-height: 1.3;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-strong);
  }
  @media (min-width: 1000px) {
    .ind__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: 4rem;
    }
  }

  .others__head h2 {
    max-width: 18ch;
  }
  .others__list {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .others__list > div {
    padding-left: 1.1rem;
    border-left: 2px solid var(--brand-100);
  }
  .others__list dt {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-size: var(--text-h4);
    font-weight: 600;
    color: var(--ink-strong);
  }
  .others__list dd {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  @media (min-width: 760px) {
    .others__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }
  @media (min-width: 1100px) {
    .others__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
