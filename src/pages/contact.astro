---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactForm from '@/components/ContactForm.astro';
import { CONTACT } from '@/consts';

const NEXT = [
  { name: 'We read it properly', body: 'Someone who understands the technology reads your message, not a sales queue.' },
  { name: 'A conversation', body: 'We arrange a call to understand the situation, the people involved and the constraints.' },
  { name: 'A clear next step', body: 'We tell you what we think the problem involves and what we recommend, including when that isn’t a big project.' },
];

const schema = [
  {
    '@type': 'ContactPage',
    name: 'Contact Lumko',
    url: 'https://lumko.cloud/contact',
    about: { '@id': 'https://lumko.cloud/#organization' },
  },
];
---

<BaseLayout
  title="Contact Lumko: Talk to a Technology Partner"
  description="Tell us what you’re trying to solve, improve or build. Contact Lumko in Bloemfontein by email, phone or WhatsApp, or book a call. Working with organisations across Southern Africa."
  schema={schema}
>
  <section class="contact">
    <div class="container container--wide">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
      <div class="contact__grid">
        <div class="contact__intro">
          <p class="index-label">Contact</p>
          <h1 class="contact__title">Let’s talk about the problem.</h1>
          <p class="lead">
            Tell us what you’re trying to solve, improve or build. We’ll help
            you work through the technology it requires.
          </p>

          <dl class="contact__direct">
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd><a href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a href={CONTACT.whatsappUrl} rel="noopener" data-analytics="whatsapp_click">Message us on WhatsApp</a></dd>
            </div>
            <div>
              <dt>Prefer to book a time?</dt>
              <dd>
                <a href={CONTACT.calendlyUrl} rel="noopener" class="link-arrow" data-analytics="calendly_click">
                  <span>Book a 30-minute call</span>
                  <Icon name="ph:arrow-up-right-light" aria-hidden="true" />
                </a>
              </dd>
            </div>
            <div>
              <dt>Where we are</dt>
              <dd>{CONTACT.locality}, {CONTACT.region}, {CONTACT.country}. Working across Southern Africa.</dd>
            </div>
          </dl>

          <div class="contact__next">
            <h2>What happens next</h2>
            <ol role="list">
              {NEXT.map((n) => (
                <li>
                  <h3>{n.name}</h3>
                  <p>{n.body}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="contact__form">
          <h2 class="visually-hidden">Send us a message</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) var(--section-y);
  }
  .contact__grid {
    display: grid;
    gap: 3.5rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .contact__title {
    margin: 1.25rem 0 1.25rem;
    font-size: var(--text-h1);
    font-weight: 620;
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    max-width: 12ch;
  }
  .contact__intro .lead {
    max-width: 44ch;
  }

  .contact__direct {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--line-strong);
  }
  .contact__direct > div {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .contact__direct dt {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--label);
  }
  .contact__direct dd {
    font-size: var(--text-base);
    color: var(--ink);
  }
  .contact__direct dd a:not(.link-arrow) {
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }
  .contact__direct dd a:not(.link-arrow):hover {
    color: var(--brand-700);
    text-decoration-color: var(--brand-700);
  }

  .contact__next {
    margin-top: 3rem;
  }
  .contact__next h2 {
    font-size: var(--text-h4);
    margin-bottom: 1rem;
  }
  .contact__next ol {
    list-style: none;
    display: grid;
    gap: 1.1rem;
  }
  .contact__next li {
    padding-left: 1rem;
    border-left: 2px solid var(--brand-100);
  }
  .contact__next h3 {
    font-size: var(--text-base);
    font-family: var(--font-sans);
    font-stretch: normal;
    letter-spacing: 0;
  }
  .contact__next p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .contact__form {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background: var(--paper);
    border: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  @media (max-width: 639px) {
    .contact__form {
      margin-inline: calc(var(--gutter) * -1);
      border-inline: 0;
    }
  }
  @media (min-width: 1000px) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 5rem;
      align-items: start;
    }
  }
</style>
