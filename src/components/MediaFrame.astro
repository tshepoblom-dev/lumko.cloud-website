---
/**
 * <MediaFrame> — a nested ("double-bezel") frame for screenshots and photos:
 * a paper shell with a hairline edge holds the image like a tray, and the
 * image sits inside with a concentric, slightly smaller radius. Stays within
 * the site's near-square radius system.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  /** Optional fixed aspect ratio for the image, e.g. "16 / 10". */
  ratio?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  caption,
  widths = [640, 960, 1280],
  sizes = '100vw',
  ratio,
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<figure class:list={['frame', className]}>
  <div class="frame__shell">
    <div class="frame__core" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .frame {
    margin: 0;
  }
  .frame__shell {
    padding: 6px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px -28px rgba(21, 4, 121, 0.28);
  }
  .frame__core {
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 4px);
    box-shadow: inset 0 0 0 1px rgba(21, 4, 121, 0.06);
    background: var(--surface);
  }
  .frame__core :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.1s var(--ease-heavy);
  }
  .frame figcaption {
    margin-top: 0.8rem;
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }
</style>
