---
/**
 * <LeadForm> — professional details requested before the full diagnostic
 * report. Rendered inside a <template> by AssessmentShell and cloned in by
 * the client controller. Submitted with fetch to /diagnostic.php.
 *
 * Contact consent is required to send; marketing consent is separate,
 * optional and never pre-ticked.
 */
import Field from '@/components/forms/Field.astro';
import Button from '@/components/Button.astro';
import { ORG_TYPES, INDUSTRIES, ORG_SIZES, REGIONS } from '@/data/diagnostics/shared';
const opt = (o: { value: string; label: string }[]) => o.map(({ value, label }) => ({ value, label }));
---

<form class="leadf" novalidate data-dx-lead aria-labelledby="dx-gate-h">
  <div class="leadf__errors" role="alert" tabindex="-1" data-dx-lead-errors hidden></div>

  <div class="leadf__grid">
    <Field id="lead-name" name="name" label="Full name" required autocomplete="name" />
    <Field id="lead-email" name="email" label="Work email" type="email" required autocomplete="email" />
    <Field id="lead-organisation" name="organisation" label="Organisation" required autocomplete="organization" />
    <Field id="lead-role" name="role" label="Role or title" required autocomplete="organization-title" />
    <Field id="lead-phone" name="phone" label="Phone (optional)" type="tel" autocomplete="tel" />
    <Field id="lead-region" name="region" label="Province or country (optional)" as="select" options={REGIONS} placeholder="Choose one" />
    <Field id="lead-org_type" name="org_type" label="Organisation type" as="select" required options={opt(ORG_TYPES)} placeholder="Choose one" />
    <Field id="lead-industry" name="industry" label="Sector" as="select" required options={opt(INDUSTRIES)} placeholder="Choose one" />
    <Field id="lead-org_size" name="org_size" label="Organisation size" as="select" required options={opt(ORG_SIZES)} placeholder="Choose one" />
  </div>

  <div class="leadf__consent field">
    <label for="lead-contact_consent">
      <input type="checkbox" id="lead-contact_consent" name="contact_consent" value="yes" required />
      <span>
        Lumko may use my details and diagnostic answers to prepare this report and
        contact me about it, as described in the <a href="/privacy#diagnostics">privacy notice</a>.
        <span class="field__req" aria-hidden="true">*</span><span class="visually-hidden">(required)</span>
      </span>
    </label>
  </div>
  <div class="leadf__consent field">
    <label for="lead-marketing_consent">
      <input type="checkbox" id="lead-marketing_consent" name="marketing_consent" value="yes" />
      <span>Optional: send me occasional Lumko insights and seminar invitations. You can unsubscribe at any time.</span>
    </label>
  </div>

  <div class="leadf__trap" aria-hidden="true">
    <label for="lead-website">Leave this field empty</label>
    <input type="text" id="lead-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="leadf__actions">
    <Button type="submit" size="lg" iconEnd="ph:arrow-right-light">Show my full report</Button>
    <p class="leadf__status" role="status" data-dx-lead-status></p>
  </div>
  <p class="leadf__note">
    Your answers are treated as confidential business information. Please don’t
    include passwords, account or tax numbers, or customer names.
  </p>
</form>

<style>
  .leadf {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .leadf__grid {
    display: grid;
    gap: 1.25rem 1.25rem;
  }
  @media (min-width: 640px) {
    .leadf__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .leadf__errors {
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--danger);
    background: var(--danger-050);
    color: var(--ink-strong);
    font-size: var(--text-sm);
  }
  .leadf__errors:focus {
    outline: 2px solid var(--danger);
    outline-offset: 2px;
  }
  .leadf__errors :global(p) {
    font-weight: 600;
  }
  .leadf__errors :global(ul) {
    margin: 0.4rem 0 0 1.1rem;
  }
  .leadf__errors :global(a) {
    color: var(--danger);
  }
  .leadf__consent label {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--text-sm);
    color: var(--ink);
    cursor: pointer;
  }
  .leadf__consent input {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    accent-color: var(--brand-700);
  }
  .leadf__consent.field--invalid label {
    color: var(--danger);
  }
  .leadf__consent :global(.field__error) {
    margin: 0.35rem 0 0 1.9rem;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--danger);
  }
  .field__req {
    color: var(--danger);
  }
  .leadf__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .leadf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .leadf__status {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .leadf__note {
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    max-width: 60ch;
  }
</style>
