---
/**
 * <NetworkMesh> — the triangulated node mesh from the Lumko glyph, used as a
 * decorative field. Points are generated deterministically at build time
 * (seeded PRNG + minimum spacing), then each point is joined to its nearest
 * neighbours, which gives the same faceted look as the logo.
 * Purely decorative: aria-hidden.
 */
interface Props {
  seed?: number;
  count?: number;
  width?: number;
  height?: number;
  /** Number of nodes rendered in signal cerulean. */
  highlights?: number;
  class?: string;
  /** Draw lines in on first paint (respects reduced motion). */
  animate?: boolean;
}

const {
  seed = 7,
  count = 34,
  width = 640,
  height = 640,
  highlights = 6,
  class: className,
  animate = true,
} = Astro.props;

function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);
const pad = 24;
const minDist = Math.sqrt((width * height) / count) * 0.62;
const pts: { x: number; y: number; r: number }[] = [];
let guard = 0;
while (pts.length < count && guard++ < 6000) {
  const x = pad + rand() * (width - pad * 2);
  const y = pad + rand() * (height - pad * 2);
  if (pts.every((p) => Math.hypot(p.x - x, p.y - y) >= minDist)) {
    pts.push({ x, y, r: 2 + rand() * 3.2 });
  }
}

// Join each node to its 3 nearest neighbours; dedupe edges.
const edgeSet = new Set<string>();
const edges: [number, number][] = [];
pts.forEach((p, i) => {
  pts
    .map((q, j) => ({ j, d: Math.hypot(p.x - q.x, p.y - q.y) }))
    .filter((o) => o.j !== i)
    .sort((a, b) => a.d - b.d)
    .slice(0, 3)
    .forEach(({ j }) => {
      const key = i < j ? `${i}-${j}` : `${j}-${i}`;
      if (!edgeSet.has(key)) {
        edgeSet.add(key);
        edges.push([i, j]);
      }
    });
});

// Highlight a spread of nodes (every nth, offset) in signal colour.
const step = Math.max(1, Math.floor(pts.length / highlights));
const isHi = (i: number) => i % step === 2 && i / step < highlights;
const f = (n: number) => Math.round(n * 10) / 10;
---

<svg
  class:list={['mesh', { 'mesh--animate': animate }, className]}
  viewBox={`0 0 ${width} ${height}`}
  aria-hidden="true"
  focusable="false"
>
  <g class="mesh__edges">
    {edges.map(([a, b], i) => (
      <line
        x1={f(pts[a].x)}
        y1={f(pts[a].y)}
        x2={f(pts[b].x)}
        y2={f(pts[b].y)}
        pathLength="1"
        style={`--i:${i % 24}`}
      />
    ))}
  </g>
  <g class="mesh__nodes">
    {pts.map((p, i) => (
      <circle
        cx={f(p.x)}
        cy={f(p.y)}
        r={isHi(i) ? f(p.r + 2) : f(p.r)}
        class:list={{ 'is-hi': isHi(i) }}
        style={`--i:${i % 24}`}
      />
    ))}
  </g>
</svg>

<style>
  .mesh {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .mesh__edges line {
    stroke: var(--mesh-line, color-mix(in srgb, var(--brand-700) 22%, transparent));
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .mesh__nodes circle {
    fill: var(--mesh-node, color-mix(in srgb, var(--brand-700) 40%, transparent));
  }
  .mesh__nodes circle.is-hi {
    fill: var(--signal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mesh--animate .mesh__edges line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: mesh-draw 1.6s var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 45ms + 150ms);
    }
    .mesh--animate .mesh__nodes circle {
      opacity: 0;
      animation: mesh-fade 900ms var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 45ms + 500ms);
    }
    .mesh--animate .mesh__nodes circle.is-hi {
      animation:
        mesh-fade 900ms var(--ease-out) forwards,
        mesh-pulse 4.8s ease-in-out 2.4s infinite;
      animation-delay: calc(var(--i) * 45ms + 500ms), calc(var(--i) * 180ms + 2.4s);
    }
  }
  @keyframes mesh-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes mesh-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes mesh-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
