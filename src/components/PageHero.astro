---
/**
 * <PageHero> — inner-page opening: index label, H1, lead, optional actions.
 * A faint corner of the node mesh anchors the right edge on wide screens.
 */
import NetworkMesh from '@/components/NetworkMesh.astro';

interface Props {
  label: string;
  title: string;
  lead?: string;
  mesh?: boolean;
  seed?: number;
}
const { label, title, lead, mesh = true, seed = 3 } = Astro.props;
---

<section class="phero">
  {mesh && (
    <div class="phero__mesh">
      <NetworkMesh seed={seed} count={22} highlights={3} />
    </div>
  )}
  <div class="container container--wide phero__inner">
    <p class="index-label">{label}</p>
    <h1 class="phero__title">{title}</h1>
    {lead && <p class="lead phero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }
  .phero__inner {
    position: relative;
  }
  .phero__title {
    margin-top: 1.25rem;
    max-width: 18ch;
    font-size: var(--text-h1);
    font-weight: 620;
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
  }
  .phero__lead {
    margin-top: 1.5rem;
    max-width: 58ch;
  }
  .phero__mesh {
    display: none;
  }
  @media (min-width: 1200px) {
    .phero__mesh {
      display: block;
      position: absolute;
      right: -6%;
      top: 50%;
      width: min(38vw, 560px);
      transform: translateY(-50%);
      opacity: 0.75;
      pointer-events: none;
    }
  }
</style>
