# Lumko — Apache configuration for the static Astro build.

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Legacy URLs from the previous site.
  RewriteRule ^(home|indexv2|_index)\.html$ / [L,R=301]
  RewriteRule ^portfolio\.html$ /work [L,R=301]
  RewriteRule ^(consult|consultform|booking|scorecard)\.html$ /contact [L,R=301]
  RewriteRule ^(articles|article-[a-z0-9-]+)\.html$ /about [L,R=301]
  RewriteRule ^solutions(/.*)?$ /what-we-do [L,R=301]
  RewriteRule ^how-it-works$ /about [L,R=301]

  # Clean URLs: /about -> about.html, /work/x -> work/x.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Strip .html from requested URLs (only for direct requests, not rewrites).
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
  RewriteCond %1 !^(404|index)$
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Astro's hashed build assets never change; everything else revalidates.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
